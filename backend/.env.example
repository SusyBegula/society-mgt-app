# Environment: 'development', 'staging' (client demo / test mode), or 'production'
APP_ENV=development

# Database connection URL (PostgreSQL + psycopg v3)
# Local Docker:
# DATABASE_URL=postgresql+psycopg://society:society@127.0.0.1:55433/society
# Supabase (Direct / Session Pooler on Port 5432):
# DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Supabase (Transaction Pooler on Port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://society:society@127.0.0.1:55433/society

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DEV_OTP=123456

# Demo overrides (set to true if demonstrating in staging/production without live SMS/Razorpay KYC)
ALLOW_DEMO_AUTH=false
ALLOW_DEMO_PAYMENT=false

# Production SMS adapter: HTTPS endpoint accepting {phone, message}; bearer token.
SMS_URL=
SMS_TOKEN=

# Payment Provider: 'development' or 'razorpay'
PAYMENT_PROVIDER=development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SOCIETY_ID=
# Map each society UUID to its own merchant credentials. Server-side only.
RAZORPAY_ACCOUNTS={}
# Explicit user UUIDs allowed to manage platform subscriptions; never phone numbers.
PLATFORM_ADMIN_USER_IDS=[]

# Storage Backend: 'local', 'supabase', or 's3'
STORAGE_BACKEND=local
STORAGE_PATH=./uploads

# Supabase Storage Configuration (when STORAGE_BACKEND=supabase)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=society

# S3 Storage Configuration (when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# CORS allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:8081"]
